# Copy to `.env` in this directory and set your key (do not commit `.env`).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional: contact email included in OSM Nominatim User-Agent (usage policy).
# NUTRICART_APP_CONTACT_EMAIL=

# Legacy (unused by default): Google Maps / Places. Nearby stores use Nominatim + Overpass instead.
# GOOGLE_MAPS_API_KEY=
